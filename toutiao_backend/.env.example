# =============================================================================
# Toutiao Backend 环境变量样例（复制为 .env 然后按需修改，.env 已在 .gitignore 中）
# =============================================================================

# ---- 数据库：MySQL（本地默认 root:root / 生产环境换成云数据库连接串）----
DATABASE_URL=mysql+aiomysql://root:root@localhost:3306/news_app?charset=utf8mb4

# ---- Redis（本地默认无密码；云 Redis 需要带上用户/密码）----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=你的Redis密码（无密码就注释掉）

# ---- JWT（用户登录/注册签名密钥，必须改成你自己的随机串）----
JWT_SECRET=请改成一个足够长的随机字符串例如用 openssl rand -hex 32
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ---- CloseAI / OpenAI 兼容 LLM（RAG 回答生成用，省钱推荐 gpt-4o-mini）----
LLM_BASE_URL=https://api.closeai-asia.com/v1
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LLM_MODEL=gpt-4o-mini

# ---- 阿里云 DashScope（备用 LLM / Embedding 兜底，不用就留空）----
DASHSCOPE_API_KEY=

# ---- BGE 嵌入模型镜像（国内用 modelscope 更快，设置后脚本优先走国内镜像）----
HF_ENDPOINT=https://hf-mirror.com
HF_HUB_DISABLE_XET=1
